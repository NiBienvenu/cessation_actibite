models:
    User: { id: id, username: string, email: string, password: string, role: string, profile_image: string, phone: string, is_active: boolean, email_verified_at: 'timestamp nullable', remember_token: 'string nullable', timestamps: timestamps, softdeletes: softDeletes, relationships: { hasMany: 'CessationActivite, UserApplication' } }
    Employe: { id: id, matricule: string, nom: string, prenom: string, genre: string, adresse: string, email: string, profil: string, phone: string, is_active: boolean, location_id: 'integer nullable', fonction_id: 'id foreign', direction_id: 'id foreign', commissariat_id: 'id foreign', application_id: 'id foreign', timestamps: timestamps, softdeletes: softDeletes, relationships: { belongsTo: 'Fonction, Direction, Commissariat, Application', hasMany: CessationActivite } }
    CessationActivite: { id: id, employe_id: 'id foreign', date_entree: date, date_sortie: date, motif_id: 'id foreign', description: text, user_id: 'id foreign nullable', timestamps: timestamps, relationships: { belongsTo: 'Employe, Motif, User' } }
    Fonction: { id: id, nom: string, timestamps: timestamps, softdeletes: softDeletes, relationships: { hasMany: Employe } }
    Direction: { id: id, nom: string, timestamps: timestamps, softdeletes: softDeletes, relationships: { hasMany: Employe } }
    Commissariat: { id: id, nom: string, timestamps: timestamps, softdeletes: softDeletes, relationships: { hasMany: Employe } }
    Motif: { id: id, titre: string, contenu: text, status: string, timestamps: timestamps, relationships: { hasMany: CessationActivite } }
    Application: { id: id, titre: string, description: string, timestamps: timestamps, relationships: { hasMany: 'Employe, UserApplication' } }
    UserApplication: { id: id, user_id: 'id foreign', application_id: 'id foreign', timestamps: timestamps, relationships: { belongsTo: 'User, Application' } }
